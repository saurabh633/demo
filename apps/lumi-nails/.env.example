# Browser API base (preferred: same-origin Next rewrite → Express :8080)
# DevTools Network will show fetches to /api-proxy/*
NEXT_PUBLIC_API_URL=/api-proxy

# Upstream Express target for next.config rewrites
INTERNAL_API_URL=http://127.0.0.1:8080

# Used for Open Graph / metadata absolute URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
